<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Lumen.Jobs</RootNamespace>
    <AssemblyName>Lumen.Jobs</AssemblyName>
    <!-- Internal to the Lumen app: never shipped as a package. Guards against the SDK's
         IsPackable default, which is how Lumen.SharedKernel leaked into a published nuspec. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Lumen.Modularity\Lumen.Modularity.csproj" />
    <ProjectReference Include="..\..\Lumen.Infrastructure\Lumen.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Audit\Lumen.Modules.Audit.Contracts\Lumen.Modules.Audit.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Lumen.Modules.Identity\Lumen.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\SharedKernel\Lumen.SharedKernel\Lumen.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.SqlServer" />
  </ItemGroup>

</Project>
